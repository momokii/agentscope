# .env.example — committed template. NEVER put real secrets here.
# Copy to .env for local development and fill in real values there.
# Rule: every new variable MUST be added here with a placeholder + description comment.
# (APP_ENV from the scaffold is unused by this project — behavior is
# controlled by the variables below, all with fail-closed defaults.)

# Listen port (host mode: the binary binds host 127.0.0.1:$PORT directly).
PORT=8080 # Pin with ./deploy.sh --port N; auto-bumps when squatted

# Listen address. Default 127.0.0.1 (loopback-only). Any non-loopback value
# (e.g. 0.0.0.0) is an explicit opt-in and the binary REFUSES to start
# unless DASHBOARD_AUTH is valid. Prefer `tailscale serve`; funnel is banned.
BIND_ADDR=127.0.0.1

# Optional HTTP Basic gate: user:pass (split on FIRST colon — passwords may
# contain colons). Unset/empty = open tailnet-trust mode. Malformed
# (no colon / empty user / empty password) = fail-closed refuse-to-serve.
# Successful Basic also mints the ocd_session cookie used by SSE.
# NEVER commit a real value here.
DASHBOARD_AUTH=user:pass

# Collector tick period (Go duration). A tick slower than 2x this is stale.
POLL_INTERVAL=10s # Plan allows 5s–15s

# Per-source bound for PollState/Sessions each tick (Go duration).
DB_TIMEOUT=10s # Raise past DB contention instead of widening mounts

# Status recency gate (Go duration): only sessions with time_updated inside
# this window may show running/waiting-input/error; older rows derive idle.
ACTIVE_WINDOW=2m

# Read-only opencode data root (parent dir keeps -wal/-shm sidecars visible).
DATA_DIR=/data/opencode # Local default: $HOME/.local/share/opencode

# Read-only pi session-store root (sessions/ subdir ONLY — the agent-root
# credential file is never mounted). Missing/unreadable = pi merge degrades
# warn-once per process.
PI_DATA_DIR=/data/pi-sessions # Local default: $HOME/.pi/agent/sessions

# Local timezone for cost_today (spend since LOCAL midnight) and log stamps.
# deploy.sh forwards the host value; compose also mounts /etc/localtime:ro.
TZ=Asia/Jakarta # Example — use your host zone

# Container user — MUST equal the host user (zellij sockets are 0700).
# Set from the host shell: export UID; GID=$(id -g)
UID=1000
GID=1000

# MUST equal the host value — the zellij CLI resolves sockets from it.
# Mismatch = blind dashboard (zero panes, looks healthy).
XDG_RUNTIME_DIR=/run/user/1000

# Only used to expand the :ro volume sources to your home (never mounted).
HOME=/home/hostuser
