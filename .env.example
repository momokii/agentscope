# .env.example — committed template. NEVER put real secrets here.
# Copy to .env for local development and fill in real values there.
# Rule: every new variable MUST be added here with a placeholder + description comment.

# Active environment. Allowed values: development | staging | production
APP_ENV=development

# Example placeholders (replace with real variables as the stack emerges):
# APP_PORT=3000 # HTTP port the app listens on
# DATABASE_URL=postgres://user:password@localhost:5432/app_dev # Primary database connection
# LOG_LEVEL=debug # Verbosity: debug in dev, warn/error in staging/prod
